# Copy this file to ".env" and fill in the values.

PORT=3000

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# OPTIONAL - Google Sign-In.
# Create an "OAuth client ID" (type: Web application) at https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# OPTIONAL - makes names, taglines, marketing content and chatbot much smarter.
# Get a key at https://console.anthropic.com/
# Without a key the app still works using the built-in offline generators.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
